FROM golang:1.22-alpine AS builder

WORKDIR /app
COPY go/go.mod go/go.sum ./
RUN go mod download

COPY go/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/bin/matching ./cmd/matching

FROM alpine:3.19
RUN apk --no-cache add ca-certificates
WORKDIR /root/
COPY --from=builder /app/bin/matching .

EXPOSE 8082
CMD ["./matching"]
