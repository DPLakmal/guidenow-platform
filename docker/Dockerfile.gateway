FROM golang:1.22-alpine AS builder

WORKDIR /app
COPY go/go.mod go/go.sum ./
RUN go mod download

COPY go/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/bin/gateway ./cmd/gateway

FROM alpine:3.19
RUN apk --no-cache add ca-certificates
WORKDIR /root/
COPY --from=builder /app/bin/gateway .

EXPOSE 8080
CMD ["./gateway"]
